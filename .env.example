# Copy to .env and fill in. .env is git ignored and must never be committed.
# Nothing here has a default that could be mistaken for a real value.

# REQUIRED IN PRODUCTION. Without it a random key is generated per process,
# which logs a warning and drops sessions on restart.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AGGSIM_SECRET_KEY=

# Public origin, used for canonical URLs, Open Graph tags and the sitemap.
AGGSIM_SITE_ORIGIN=http://localhost:5000

# Real contact details. Left empty the site says so plainly on the contact,
# privacy and footer areas rather than showing an invented address.
AGGSIM_CONTACT_ORG=
AGGSIM_CONTACT_EMAIL=
AGGSIM_CONTACT_ADDRESS=

# Analytics is off unless you switch it on. When it is off no cookie is set
# and no consent banner is shown, because there is nothing to consent to.
AGGSIM_ANALYTICS_ENABLED=false
AGGSIM_ANALYTICS_SCRIPT_URL=

# Limits. Simulation cost is bounded by total integration steps, not just by
# request rate, because one long request can cost more than many page views.
AGGSIM_RATE_LIMIT_PER_MINUTE=120
AGGSIM_RATE_LIMIT_BURST=40
AGGSIM_MAX_CONTENT_LENGTH=16384
AGGSIM_MAX_SIMULATION_STEPS=40000

AGGSIM_DEBUG=false
AGGSIM_HOST=127.0.0.1
AGGSIM_PORT=5000
